{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "莱尚网电竞馆点购管理端",
  "mainBinaryName": "莱尚网电竞馆点购管理端",
  "version": "0.3.0",
  "identifier": "com.cybercafeShop.admin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14201",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../assets/data": "seed/data",
      "../../mobile/dist": "seed/web/m"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
